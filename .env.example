# =============================================================================
# Hiver AI Support Agent — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
# cp .env.example .env
#
# Groq API (free tier — https://console.groq.com/keys)
# Sign up at https://console.groq.com, go to API Keys, create one.
# No credit card required.
GROQ_API_KEY=your_groq_api_key_here

# Model to use (options: qwen/qwen3.8-27b, openai/gpt-oss-120b)
GROQ_MODEL=qwen/qwen3.8-27b
